<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example project exercising jobrunr-maven-plugin's aws-ecs:build goal end to end against real
  AWS: native-image compilation for both x86_64 and arm64, offloaded to ECS Fargate tasks running
  in eu-west-1, using jobrunr-test-infra's deployed stack (plain S3 staging, direct-S3-calls agent
  I/O mode — see jobrunr-test-infra/README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cloud.plasticity.example</groupId>
    <artifactId>jobrunr-example-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>jobrunr-maven-plugin example app</name>
    <description>
        Minimal, reflection-free "hello world" plus one small real dependency (Commons Lang3, to
        exercise a genuine classpath jar through the plugin's content-addressed S3 staging), used
        to prove aws-ecs:build's real, end-to-end pipeline: stage inputs, register a task
        definition per (build kind, architecture) cell, launch and supervise Fargate tasks for
        both x86_64 and arm64 concurrently, retrieve the produced native binaries.
    </description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- One small, real dependency jar so the classpath staging path (S3StagingSink's
             content-addressed dedup) has something genuine to upload, not just this project's own
             single class file. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.19.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>jobrunr-example-app</finalName>
        <plugins>
            <!--
              Reads deployment.properties (copied from deployment.properties.example and filled
              in with real, account-specific values — see that file's own header comment) into
              Maven properties at build start, so the jobrunr-maven-plugin configuration below can
              reference them as placeholders instead of hardcoding one AWS account's specific
              resource identifiers directly into a committed example. Bound to validate (before
              initialize) so the properties exist before anything else in the build needs them.

              Deliberately not <quiet>true</quiet>: if deployment.properties is missing (e.g. a
              fresh checkout that hasn't copied the .example file yet), the build should fail
              clearly here, not proceed with unresolved ${...} placeholders passed literally into
              the plugin configuration.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.3.1</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>read-project-properties</goal>
                        </goals>
                        <configuration>
                            <files>
                                <file>${project.basedir}/deployment.properties</file>
                            </files>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>cloud.plasticity.example.HelloNative</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>cloud.plasticity</groupId>
                <artifactId>jobrunr-maven-plugin</artifactId>
                <version>1.0.0-SNAPSHOT</version>
                <executions>
                    <execution>
                        <id>native-image-both-architectures</id>
                        <phase>package</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Matrix: one build kind (plain NATIVE), both architectures — two Fargate
                         tasks launched concurrently, one per architecture, per BuildMojo's own
                         "one task per matrix cell" design. -->
                    <buildKinds>
                        <buildKind>native</buildKind>
                    </buildKinds>
                    <architectures>
                        <architecture>x86_64</architecture>
                        <architecture>arm64</architecture>
                    </architectures>
                    <mainClass>cloud.plasticity.example.HelloNative</mainClass>
                    <imageName>hello-native</imageName>

                    <!-- forceRemote=true: send both cells to ECS regardless of host architecture —
                         the default otherwise builds a host-matching cell locally with no AWS
                         calls at all, which would defeat the point of this example (proving the
                         real, remote, both-architectures path). -->
                    <forceRemote>true</forceRemote>

                    <!-- All account/deployment-specific values below come from
                         deployment.properties (see deployment.properties.example) via
                         properties-maven-plugin, not hardcoded — see this file's own header
                         comment and that properties file's header for where each value comes
                         from. -->
                    <region>${aws-ecs.region}</region>
                    <clusterArn>${aws-ecs.clusterArn}</clusterArn>
                    <!-- Each subnet/security-group is its own property (rather than one
                         comma-joined value split at runtime) — Maven's handling of a single
                         string value for a List<String>-typed plugin parameter isn't guaranteed
                         to comma-split inside a nested XML element the way -Dprop=a,b does on the
                         command line, so this avoids relying on that. Add
                         aws-ecs.subnetId.3=... etc. to deployment.properties (and a matching
                         <subnetId> element here) if your VPC has more subnets to offer. -->
                    <subnetIds>
                        <subnetId>${aws-ecs.subnetId.1}</subnetId>
                        <subnetId>${aws-ecs.subnetId.2}</subnetId>
                    </subnetIds>
                    <securityGroupIds>
                        <securityGroupId>${aws-ecs.securityGroupId.1}</securityGroupId>
                    </securityGroupIds>
                    <assignPublicIp>true</assignPublicIp>
                    <executionRoleArn>${aws-ecs.executionRoleArn}</executionRoleArn>
                    <taskRoleArn>${aws-ecs.taskRoleArn}</taskRoleArn>
                    <logGroupName>/jobrunr/build-agent</logGroupName>
                    <s3Bucket>${aws-ecs.s3Bucket}</s3Bucket>

                    <!-- Plain S3, direct-S3-calls agent I/O — jobrunr-test-infra's default
                         (includeS3Files=false) deployment mode; no mount infrastructure exists to
                         fall back on. -->
                    <agentUsesDirectS3Io>true</agentUsesDirectS3Io>
                    <agentImageUri>${aws-ecs.agentImageUri}</agentImageUri>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

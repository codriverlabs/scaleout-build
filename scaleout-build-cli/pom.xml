<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.codriverlabs</groupId>
        <artifactId>scaleout-build-parent</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>scaleout-build-cli</artifactId>
    <name>scaleout-build-cli</name>
    <description>
        Command-line interface for the scaleout-build control plane.
        Covers build lifecycle (list, status, cancel) and MicroVM image management.
        Distributed as a fat jar; requires AWS credentials (SigV4) and the endpoint URL.
    </description>

    <dependencies>
        <!-- Wire contract, SigV4 signer, DTOs -->
        <dependency>
            <groupId>ai.codriverlabs</groupId>
            <artifactId>scaleout-build-control-plane-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- AWS SDK region type — transitive through the API module but needed directly -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
        </dependency>
        <!-- AWS SDK auth — declared optional in the API module, so must be explicit here -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-auth-aws</artifactId>
        </dependency>

        <!-- Argument parsing: zero transitive deps, GraalVM-native-compatible. -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.7</version>
        </dependency>
        <!--
          picocli-codegen: annotation processor that generates GraalVM reflection config.
          Scope=provided so it is on the annotation processor path only, not the runtime classpath.
        -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <version>4.7.7</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Suppress SLF4J "no providers found" warning in the fat jar -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Enable picocli-codegen annotation processor so it generates
              reflect-config.json under META-INF/native-image at compile time.
              This covers @Command, @Option, @Parameters classes automatically.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>4.7.7</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ai.codriverlabs.scaleoutbuild.cli.ScaleoutCli</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!--
              remote-native: compile the CLI using the scaleout-build compute gateway.
              Builds both arm64 and x86_64 in parallel on remote Fargate tasks.

              Prerequisites: mvn package -pl scaleout-build-cli -am (produces fat jar and
              picocli reflect-config in target/classes/META-INF/native-image).

              Usage:
                EP=$(aws ssm get-parameter -name /scaleout-build/control-plane/endpoint \
                  -region eu-central-1 -query Parameter.Value -output text)
                mvn package -Premote-native -Dscaleout-build.endpoint="$EP" \
                  -pl scaleout-build-cli -am

              Outputs:
                target/scaleout-build/remote-artifacts/NATIVE-ARM64/scaleout
                target/scaleout-build/remote-artifacts/NATIVE-X86_64/scaleout

              The fat jar + target/classes (which contains the picocli reflect-config in
              META-INF/native-image) are staged via DerivedClasspathStrategy. The agent
              discovers the reflect-config automatically from the classpath.
            -->
            <id>remote-native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>ai.codriverlabs</groupId>
                        <artifactId>scaleout-build-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>remote-native-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <configuration>
                                    <buildKinds>
                                        <buildKind>native</buildKind>
                                    </buildKinds>
                                    <architectures>
                                        <architecture>x86_64</architecture>
                                        <architecture>arm64</architecture>
                                    </architectures>
                                    <imageName>scaleout</imageName>
                                    <mainClass>ai.codriverlabs.scaleoutbuild.cli.ScaleoutCli</mainClass>
                                    <forceRemote>true</forceRemote>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!--
              native: compile the CLI fat jar to a native executable using GraalVM/Mandrel.
              Requires GraalVM or Mandrel with native-image installed locally.
              Usage: mvn package -Pnative -pl scaleout-build-cli -am
            -->
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.14</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>scaleout</imageName>
                            <mainClass>ai.codriverlabs.scaleoutbuild.cli.ScaleoutCli</mainClass>
                            <classpath>
                                <param>${project.build.directory}/${project.artifactId}-${project.version}.jar</param>
                            </classpath>
                            <buildArgs>
                                <buildArg>-O1</buildArg>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--initialize-at-run-time=software.amazon.awssdk.auth,software.amazon.awssdk.http.urlconnection.UrlConnectionHttpClient</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
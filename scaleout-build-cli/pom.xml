<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.codriverlabs</groupId>
        <artifactId>scaleout-build-parent</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>scaleout-build-cli</artifactId>
    <name>scaleout-build-cli</name>
    <description>
        Command-line interface for the scaleout-build control plane.
        Covers build lifecycle (list, status, cancel) and MicroVM image management.
        Distributed as a fat jar; requires AWS credentials (SigV4) and the endpoint URL.
    </description>

    <dependencies>
        <!-- Wire contract, SigV4 signer, DTOs -->
        <dependency>
            <groupId>ai.codriverlabs</groupId>
            <artifactId>scaleout-build-control-plane-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- AWS SDK region type — transitive through the API module but needed directly -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
        </dependency>

        <!-- Argument parsing: zero transitive deps, GraalVM-native-compatible. -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.7</version>
        </dependency>
        <!--
          picocli-codegen: annotation processor that generates GraalVM reflection config.
          Scope=provided so it is on the annotation processor path only, not the runtime classpath.
        -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <version>4.7.7</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Suppress SLF4J "no providers found" warning in the fat jar -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Enable picocli-codegen annotation processor so it generates
              reflect-config.json under META-INF/native-image at compile time.
              This covers @Command, @Option, @Parameters classes automatically.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>4.7.7</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ai.codriverlabs.scaleoutbuild.cli.ScaleoutCli</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Native profile: compiles the CLI fat jar to a native executable using GraalVM/Mandrel.
          Activated by -Pnative or -Dnative.

          Usage (requires GraalVM or Mandrel with native-image):
            mvn -B package -Pnative -pl scaleout-build-cli -am

          The native executable is produced at target/scaleout (arm64) or target/scaleout-x86
          depending on the host. In CI, this runs on the arm64 native runner.

          What the native build needs:
          - picocli-codegen annotation processor generates reflect-config.json at compile time
          - Jackson: reflection config for the DTOs is generated by the processor for
            @JsonSerialize/@JsonDeserialize. Classes registered via ObjectMapper at runtime
            need explicit - initialize-at-run-time or reflect-config entries.
          - AWS SDK: credentials chain (env, ~/.aws/config, IMDS) is initialized at runtime.
        -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.14</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>scaleout</imageName>
                            <mainClass>ai.codriverlabs.scaleoutbuild.cli.ScaleoutCli</mainClass>
                            <!--
                              The fat jar already has all classes; use it as the class path
                              so we don't have to re-enumerate every transitive dependency.
                            -->
                            <classpath>
                                <param>${project.build.directory}/${project.artifactId}-${project.version}.jar</param>
                            </classpath>
                            <buildArgs>
                                <!-- Prefer small binary over maximum optimization -->
                                <buildArg>-O1</buildArg>
                                <!-- Fail the build rather than producing a binary with fallback -->
                                <buildArg>--no-fallback</buildArg>
                                <!--
                                  AWS SDK credential chain initializes at runtime (reads env vars,
                                  ~/.aws/config, and IMDS — none of which exist at build time).
                                -->
                                <buildArg>--initialize-at-run-time=software.amazon.awssdk.auth,software.amazon.awssdk.http.urlconnection.UrlConnectionHttpClient</buildArg>
                                <!-- Jackson's date/time module uses reflection -->
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

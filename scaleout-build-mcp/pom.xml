<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.codriverlabs</groupId>
        <artifactId>scaleout-build-parent</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>scaleout-build-mcp</artifactId>
    <name>scaleout-build-mcp</name>
    <description>
        MCP (Model Context Protocol) server for the scaleout-build control plane.
        Exposes build lifecycle and MicroVM image management as MCP tools so AI assistants
        can trigger, monitor, and cancel native-image builds directly.
        Built on Quarkus MCP Server (stdio transport); configure as a local MCP server.
    </description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>3.40.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Quarkus MCP Server — stdio transport for use as a local MCP server -->
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-stdio</artifactId>
            <version>2.0.2</version>
        </dependency>

        <!-- Wire contract, SigV4 signer, DTOs, and the ControlPlaneHttpClient -->
        <dependency>
            <groupId>ai.codriverlabs</groupId>
            <artifactId>scaleout-build-cli</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- AWS SDK deps for SigV4 signing (transitive from API module) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-auth-aws</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5-mockito</artifactId>
            <version>3.40.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>3.40.1</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.native.container-build>false</quarkus.native.container-build>
                <quarkus.native.additional-build-args>
                    --initialize-at-run-time=software.amazon.awssdk.auth,software.amazon.awssdk.http.urlconnection.UrlConnectionHttpClient
                </quarkus.native.additional-build-args>
            </properties>
        </profile>

        <profile>
            <!-- Emit Quarkus native-image sources without compiling. Run before remote-native. -->
            <id>native-sources</id>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.native.sources-only>true</quarkus.native.sources-only>
            </properties>
        </profile>

        <profile>
            <!--
              remote-native: compile the MCP server using the scaleout-build compute gateway.
              Two steps: first emit native sources locally, then compile remotely.

              Step 1: mvn package -Pnative-sources -pl scaleout-build-mcp -am
              Step 2: mvn package -Premote-native -Dscaleout-build.endpoint="$EP" -pl scaleout-build-mcp -am

              Outputs: target/scaleout-build/remote-artifacts/NATIVE-ARM64/scaleout-build-mcp-runner
            -->
            <id>remote-native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>ai.codriverlabs</groupId>
                        <artifactId>scaleout-build-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>remote-native-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <configuration>
                                    <buildKinds>
                                        <buildKind>native</buildKind>
                                    </buildKinds>
                                    <architectures>
                                        <architecture>arm64</architecture>
                                        <architecture>x86_64</architecture>
                                    </architectures>
                                    <forceRemote>true</forceRemote>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
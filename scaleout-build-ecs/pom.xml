<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.codriverlabs</groupId>
        <artifactId>scaleout-build-parent</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>scaleout-build-ecs</artifactId>
    <packaging>jar</packaging>

    <name>Scaleout Build (ECS orchestration)</name>
    <description>
        ECS task orchestration, S3 staging, and native-image input planning. Extracted from
        scaleout-build-maven-plugin so that both the plugin's direct-ECS backend and the
        control-plane service can launch and supervise build tasks without the service having to
        depend on the Maven plugin (and therefore on maven-plugin-api).

        Named for ECS because that is the only backend today. If a second backend appears (see
        docs/design/control-plane/scaleout-builder-control-plane.md's MicroVM note), the launch
        abstraction belongs here and the module is worth renaming then rather than pre-emptively.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.codriverlabs</groupId>
            <artifactId>scaleout-build-shared</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ecs</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatchlogs</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.codriverlabs</groupId>
    <artifactId>scaleout-build-parent</artifactId>
    <version>1.0.1</version>
    <packaging>pom</packaging>

    <name>Scaleout Build (parent)</name>
    <description>
        Maven plugin that computes a GraalVM/Mandrel native-image build matrix and scales it out
        across remote workers (AWS ECS Fargate today) for cells that don't match the local host's
        architecture, one worker per matrix cell.
    </description>

    <url>https://github.com/codriverlabs/scaleout-build</url>

    <!--
        Required by Maven Central, which rejects a deployment missing any of url, licenses, developers
        or scm. Declared on the parent so every published module inherits them rather than repeating
        them four times: only the parent plus shared, control-plane-api, ecs and the plugin are
        deployed, and the rest are deployables that publish.yml excludes.

        Useful before Central too: a consumer resolving from GitHub Packages sees the licence and the
        source location in the POM their IDE already downloaded.
    -->
    <licenses>
        <license>
            <name>Elastic License 2.0 (ELv2)</name>
            <url>https://github.com/codriverlabs/scaleout-build/blob/main/LICENSE</url>
            <distribution>repo</distribution>
            <!--
                Not OSI-approved, which Central permits: it requires a declared licence, not an
                approved one. Elasticsearch publishes ELv2 artifacts to Central on the same basis.
            -->
            <comments>
                Free to use, modify and redistribute. The restriction is on offering this software to
                third parties as a hosted or managed service exposing its functionality.
            </comments>
        </license>
    </licenses>

    <organization>
        <name>CoDriver Labs</name>
        <url>https://codriverlabs.ai</url>
    </organization>

    <developers>
        <developer>
            <name>CoDriver Labs</name>
            <email>support@codriverlabs.ai</email>
            <organization>CoDriver Labs</organization>
            <organizationUrl>https://codriverlabs.ai</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/codriverlabs/scaleout-build.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/codriverlabs/scaleout-build.git</developerConnection>
        <url>https://github.com/codriverlabs/scaleout-build</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/codriverlabs/scaleout-build/issues</url>
    </issueManagement>

    <modules>
        <module>scaleout-build-shared</module>
        <module>scaleout-build-control-plane-api</module>
        <module>scaleout-build-ecs</module>
        <module>scaleout-build-control-plane</module>
        <module>scaleout-build-control-plane-reaper</module>
        <module>scaleout-build-control-plane-infra</module>
        <module>scaleout-build-cli</module>
        <module>scaleout-build-maven-plugin</module>
        <module>scaleout-build-agent</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Runtime dependencies -->
        <awssdk.version>2.55.11</awssdk.version>
        <jackson.version>2.22.3</jackson.version>
        <!-- Jakarta REST 4.0 is the latest published (4.0.1/4.1.0 do not exist on Central). -->
        <jakarta-ws-rs.version>4.0.0</jakarta-ws-rs.version>
        <slf4j.version>2.0.20</slf4j.version>

        <!-- Maven API (provided scope: supplied by the running Maven instance) -->
        <maven.version>3.9.16</maven.version>
        <maven-plugin-tools.version>3.16.0</maven-plugin-tools.version>

        <!-- Test dependencies -->
        <junit.version>6.1.3</junit.version>
        <mockito.version>5.24.0</mockito.version>
        <assertj.version>3.27.7</assertj.version>
        <maven-plugin-testing.version>3.3.0</maven-plugin-testing.version>
        <testcontainers.version>2.0.5</testcontainers.version>

        <!-- Build plugins -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <!--
            Latest stable, each resolved against Central rather than taken from memory, per
            .kiro/steering/tech.md. Note maven-source-plugin's newest published version is
            4.0.0-beta-1, which is deliberately not used: the steering rejects pre-release
            identifiers, so this pins the newest plain x.y.z.
        -->
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <!--
            maven-gpg-plugin 3.2.8 and central-publishing-maven-plugin 0.11.0: both resolved
            against Central (never recalled) before pinning, per .kiro/steering/tech.md.
        -->
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-plugin-plugin.version>3.16.0</maven-plugin-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.codriverlabs</groupId>
                <artifactId>scaleout-build-shared</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta-ws-rs.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Sources and javadoc for every published module. Maven Central requires both for any
            packaging other than pom, and they are worth having before Central too: a consumer
            resolving from GitHub Packages gets IDE navigation into the plugin's own code.

            Bound in the parent's build rather than pluginManagement so they apply to every module
            without each one opting in. The deployables that publish.yml excludes (control plane,
            reaper, agent, infra) pay a few seconds building jars nobody consumes, which is cheaper
            than four copies of this block drifting apart.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <!--
                        This codebase documents reasoning at length, including measured figures and
                        references to commits. Failing a release on a malformed @link in a comment
                        that explains why a timeout is 30 minutes would be the wrong trade, so
                        doclint is off and the build does not fail on javadoc errors.
                    -->
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-plugin-plugin</artifactId>
                    <version>${maven-plugin-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <!--
            Activated by the CI publish workflow via -Prelease. Never activated locally unless you
            set the environment variables: signing would fail and central-publishing-maven-plugin
            would try to talk to Central on every mvn verify.

            The profile:
              1. Signs every file with the GPG key stored in MAVEN_GPG_PRIVATE_KEY.
              2. Publishes to Maven Central via the Central Portal API (automatic release rather
                 than the old OSSRH manual staging).

            See docs/design/ci-cd/publishing-to-maven-central.md for the full requirements,
            the namespace claim, and the Sonatype commercial-nature question.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <!--
                                        In CI the private key is imported from the
                                        MAVEN_GPG_PRIVATE_KEY secret before the build runs.
                                        passphrase is empty; the key has no protection.
                                        useAgent=false so the key is used directly without a
                                        running gpg-agent, which avoids TTY issues on runners.
                                    -->
                                    <keyname>karol.piatek@codriverlabs.ai</keyname>
                                    <passphrase>${env.MAVEN_GPG_PASSPHRASE}</passphrase>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!--
                                publishingServerId must match a <server> in ~/.m2/settings.xml (locally)
                                or the CI settings.xml generated by the workflow.
                                autoPublish=true releases immediately rather than requiring a manual
                                portal click; waitUntil=published makes the build wait for confirmation.
                            -->
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
